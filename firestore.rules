rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        "A0B3ZEXfcqhSquqQkoqZ0I6BRtD3",
        "GL5yI9uYdJUReqLczdO0RWVIkdk1",
        "xgEpG6IVB9TtBoTU3KIavIrfHSA3",
        "znbtJJzpq8huSgDG5S5D24iKqYl1",
        "Ha28aVcdNrV1C4kNg2rj64WS8yg1",
        "JAv4EnqMyiWJKBByu7a2uQnXcTB2"
      ];
    }

    match /appointments/{appointmentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'active';
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        || isAdmin();
    }

    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /blockedDates/{dateId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // OTP codes are written/read exclusively by Cloud Functions (Admin SDK bypasses rules).
    // Deny all client access.
    match /otpCodes/{phone} {
      allow read, write: if false;
    }

    // Gallery: public read (portfolio), admin-only write.
    match /gallery/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
