# Copy this to .env and fill in your Twilio credentials.
# For production, set these as Firebase Secrets:
#   firebase functions:secrets:set TWILIO_ACCOUNT_SID
#   firebase functions:secrets:set TWILIO_AUTH_TOKEN
#   firebase functions:secrets:set TWILIO_WHATSAPP_FROM

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio WhatsApp Sandbox sender (testing):
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Production approved sender (replace with your WhatsApp Business number):
# TWILIO_WHATSAPP_FROM=whatsapp:+972XXXXXXXXX
